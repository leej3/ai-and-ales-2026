        {
          "kind": "text",
          "text": "STAMPED asks about the package:\nits history, its parts, its environment,\nand how someone else can use it.",
          "x": 730,
          "y": 395,
          "w": 490,
          "h": 150,
          "size": 28,
          "bold": false
        },
        {
          "kind": "text",
          "text": "Research objects with AI: the talk",
          "x": 64,
          "y": 646,
          "w": 640,
          "h": 38,
          "size": 24,
          "bold": false,
          "color": "#15716e",
